{
  "name": "bnb-treasury-helper",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "A read-only BNB Chain lending health-factor monitor with optional onchain report recording.",
  "scripts": {
    "start": "node server.js",
    "test": "npm run test:unit && npm run test:contracts",
    "test:unit": "node --test test/healthFactor.test.js test/api.test.js test/monitor.test.js",
    "test:contracts": "hardhat test test/HealthReport.test.js",
    "compile": "hardhat compile",
    "deploy": "hardhat run scripts/deploy.js --network bsc",
    "monitor": "node scripts/runMonitor.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "dotenv": "^16.4.7",
    "ethers": "^6.14.4",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-ethers": "^3.1.0",
    "chai": "^4.5.0",
    "hardhat": "^2.26.3",
    "supertest": "^7.1.1"
  }
}